# Shared by every tape: the terminal the README recordings are drawn in.
Set Shell bash
Set FontFamily "Hack Nerd Font Mono"
Set FontSize 15
Set Width 1240
Set Height 700
Set Padding 18
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 45ms
Set Framerate 15
Set Theme { "name": "kurama", "background": "#16161a", "foreground": "#eaf4fc", "cursor": "#38a1db", "selection": "#1e50a2", "black": "#16161a", "red": "#e9546b", "green": "#98d98e", "yellow": "#f8b500", "blue": "#38a1db", "magenta": "#a59aca", "cyan": "#80aba9", "white": "#eaf4fc", "brightBlack": "#7b7c7d", "brightRed": "#f09199", "brightGreen": "#b8d200", "brightYellow": "#ffd900", "brightBlue": "#89c3eb", "brightMagenta": "#bbc8e6", "brightCyan": "#a0d8ef", "brightWhite": "#ffffff" }

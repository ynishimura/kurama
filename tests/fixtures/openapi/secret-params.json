{
  "openapi": "3.0.3",
  "info": {"title": "Keys", "version": "1"},
  "paths": {
    "/keys/{keyId}": {
      "get": {
        "operationId": "keys/get",
        "summary": "One key, read with a credential in a header and in the query",
        "parameters": [
          {"name": "keyId", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "X-Api-Key", "in": "header", "schema": {"type": "string"}},
          {"name": "access_token", "in": "query", "schema": {"type": "string"}},
          {"name": "q", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "The key"}}
      }
    }
  }
}
